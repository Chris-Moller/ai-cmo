{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "isolatedModules": true
  },
  "references": [
    { "path": "packages/types" },
    { "path": "packages/db" },
    { "path": "packages/agents" },
    { "path": "packages/config" },
    { "path": "packages/lib" }
  ],
  "exclude": ["node_modules", "dist"]
}
